# Production environment — copy to .env on server, never commit real secrets
# See DEPLOYMENT.md and OPERATIONAL_CHECKLIST.md

ENV=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database — Postgres for production (replace with real credentials, use Secret Manager)
# Example: postgresql://email_agent_user:STRONG_PASSWORD@db:5432/email_agent_prod
DATABASE_URL=postgresql://user:password@db:5432/email_agent_prod

# Secrets — required in production (enforced by config)
SECRET_KEY=change-me-to-64-char-random-in-production
ADMIN_TOKEN=your-strong-32-char-admin-token-here

# LLM — provider-agnostic (openai or mock)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your-real-openai-key-here

# Gmail OAuth — production redirect must be HTTPS
GMAIL_CLIENT_ID=your-prod-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-prod-client-secret
GMAIL_REDIRECT_URI=https://yourdomain.com/gmail/auth/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
GMAIL_SEND_SCOPES=https://www.googleapis.com/auth/gmail.send
GMAIL_CREDENTIALS_PATH=/app/secrets/credentials.json
GMAIL_TOKEN_PATH=/app/secrets/token.json

# RAG — approved knowledge only
RAG_KNOWLEDGE_DIR=/app/knowledge
RAG_TOP_K=3
RAG_EMBEDDING_PROVIDER=openai

# Scheduler — disabled by default, enable explicitly after gate verified
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=300
SCHEDULER_QUERY=in:inbox -in:sent -in:spam -in:trash newer_than:{window}d
SCHEDULER_NEWER_THAN_DAYS=2
SCHEDULER_MAX_RETRIES=3

# Security — production hardening
RATE_LIMIT_PER_MINUTE=60
CORS_ALLOW_ORIGINS=https://admin.yourdomain.com
# CORS_ALLOW_ORIGINS=  # leave empty to disable CORS (safe default)
