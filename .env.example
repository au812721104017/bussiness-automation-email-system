# Phase 1: FastAPI Foundation — copy to .env and fill real values
# Never commit .env with real secrets

# App
ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database (Phase 2: SQLite for dev, Postgres for prod)
DATABASE_URL=sqlite:///./email_automation.db
# DATABASE_URL=postgresql://user:password@localhost:5432/email_agent

# LLM (Phase 5: provider-agnostic, optional in Phase 1)
OPENAI_API_KEY=sk-your-real-key-here

# Gmail OAuth (Phase 3: read-only first, minimum scopes)
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REDIRECT_URI=http://localhost:8000/gmail/auth/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./token.json

# LLM / Classification (Phase 4: provider-agnostic, deterministic rules + LLM)
LLM_PROVIDER=mock
LLM_MODEL=mock-classifier-v1
# LLM_PROVIDER=openai
# OPENAI_API_KEY already above

# RAG (Phase 6: approved knowledge only, replaceable vector store)
RAG_TOP_K=3
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_KNOWLEDGE_DIR=./knowledge
RAG_EMBEDDING_PROVIDER=mock
# RAG_EMBEDDING_PROVIDER=openai

# Gmail Send (Phase 8: behind approval gate, no auto-send)
GMAIL_SEND_SCOPES=https://www.googleapis.com/auth/gmail.send

# Scheduler (Phase 10: safe polling, dedup, retry, disabled in tests by default)
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_MAX_RETRIES=3
SCHEDULER_RETRY_BACKOFF_SECONDS=1.0
# Read-state agnostic: processes READ and UNREAD inbound mail. {window} = SCHEDULER_NEWER_THAN_DAYS
SCHEDULER_QUERY=in:inbox -in:sent -in:spam -in:trash newer_than:{window}d
SCHEDULER_NEWER_THAN_DAYS=2

# Admin (Phase 11: safe review dashboard, temp auth for local dev)
# For production, set a strong token and require X-Admin-Token header. In dev, leave empty to allow without auth (with warning).
ADMIN_TOKEN=
# ADMIN_TOKEN=your-strong-random-token-here

# Security & Reliability (Phase 12: hardening defaults, do not weaken gate)
RATE_LIMIT_PER_MINUTE=60
CORS_ALLOW_ORIGINS=
# CORS_ALLOW_ORIGINS=https://admin.yourdomain.com
PRODUCTION_HARDENING=false
# ENV=production  # set to enforce prod checks

# Security
SECRET_KEY=change-me-to-a-random-secret-in-production

# SMTP (legacy Phase 3, will be replaced by Gmail send in Phase 8)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password
